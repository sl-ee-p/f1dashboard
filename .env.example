# Host port for the dashboard.
F1DASH_PORT=8050
# Optional; a random key per process is fine (no logins or sessions).
# F1DASH_SECRET_KEY=
# Turn the /live replay page off.
# F1DASH_LIVE_ENABLED=0
# Max concurrent live-replay streams (each holds one server thread).
# F1DASH_MAX_LIVE_STREAMS=4
# Serve only from the on-disk cache, never call upstream APIs.
# F1DASH_OFFLINE=1
